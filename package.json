{
  "name": "payment-dates",
  "version": "1.0.0",
  "description": "Generates a CSV with salary and bonus payment dates for the remainder of the year (Dawn Technology 'Mikko test').",
  "type": "module",
  "private": true,
  "bin": {
    "payment-dates": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
